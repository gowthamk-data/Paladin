# Copy to .env (same directory as docker-compose.yml) and adjust before running `docker compose up`.
# `docker compose up` fails fast with a clear message if POSTGRES_PASSWORD is missing, rather
# than starting PostgreSQL with an empty password.

# --- required -------------------------------------------------------------------------------
# Used both to initialise the database and to build the gateway's DATABASE_URL. Change it for
# anything other than a throwaway local demo.
POSTGRES_PASSWORD=change_me_strong_password

# --- demo-user seeding ----------------------------------------------------------------------
# Production/hosted seeding requires four distinct secrets, each 12-72 UTF-8 bytes.
# Use the *_PASSWORD_FILE variables for mounted secret files; do not reuse admin1's secret.
# PALADIN_ENV=production disables the --local-dev escape hatch.
PALADIN_ENV=
PALADIN_SEED_EMP1_PASSWORD=
PALADIN_SEED_EMP1_PASSWORD_FILE=
PALADIN_SEED_MGR1_PASSWORD=
PALADIN_SEED_MGR1_PASSWORD_FILE=
PALADIN_SEED_ADMIN1_PASSWORD=
PALADIN_SEED_ADMIN1_PASSWORD_FILE=
PALADIN_SEED_FIN1_PASSWORD=
PALADIN_SEED_FIN1_PASSWORD_FILE=

# --- authentication -------------------------------------------------------------------------
JWT_ALGORITHM=RS256
# Access-token lifetime in minutes. There is no refresh token or server-side revocation list:
# lowering this is the only lever that shortens the exposure of a leaked token.
JWT_EXPIRY_MINUTES=30

# --- rate limiting --------------------------------------------------------------------------
# Sustained requests per minute per authenticated user, measured over a 6-minute window.
RATE_LIMIT_PER_MINUTE=10
# Short-window burst allowance per authenticated user. Values below RATE_LIMIT_PER_MINUTE are
# floored to it, otherwise the policy would be stricter than configured.
RATE_LIMIT_BURST=20

# --- LLM backend ----------------------------------------------------------------------------
# Local default is the small model; the deployed/demo instance sets OLLAMA_MODEL=llama3.
OLLAMA_MODEL=llama3.2:3b
# Deployed/demo: OLLAMA_MODEL=llama3
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=10m
# Hard timeout for a single generation call, in seconds. A stalled request returns HTTP 503
# instead of holding a gateway worker thread forever.
OLLAMA_TIMEOUT_SECONDS=300

# --- retrieval ------------------------------------------------------------------------------
# Must be identical for ingestion (data/ingest.py) and querying, or the stored vectors and the
# query vector will not be comparable.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- request limits -------------------------------------------------------------------------
# Maximum prompt length in characters; longer prompts are rejected with HTTP 413 before any
# embedding, audit write or LLM call happens.
MAX_PROMPT_CHARS=8000
# Maximum declared request body size in bytes; larger bodies are rejected with HTTP 413.
MAX_REQUEST_BYTES=32000

# --- observability --------------------------------------------------------------------------
# Python log level applied to the gateway's own loggers (INFO, WARNING, ERROR, DEBUG).
LOG_LEVEL=INFO
