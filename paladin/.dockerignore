# Keep the build context small and, more importantly, keep secrets out of the images.
#
# The JWT signing keys are bind-mounted read-only at run time (docker-compose.yml); they must
# never be copied into an image layer where anyone who can pull the image could read them.
keys/
.env
.env.example

# VCS + editor + OS noise
.git
.gitignore
.kilo/
.vscode/
.idea/
*.swp

# Python artefacts (regenerated in the image by the build)
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Project docs and test harnesses: not needed by either image at run time
paladin-plan.md
README.md
tests/
test_*.py
scripts/
*.log
